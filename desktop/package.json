{
  "name": "clankerspanker-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ClankerSpanker Linux desktop (Electron) — sessions, host start/stop/settings, tray. Mac uses native app.",
  "main": "src/main.js",
  "homepage": "https://github.com/nightmoose/ClankerSpanker",
  "author": {
    "name": "nightmoose",
    "email": "alex.suarez@nightmoose.com"
  },
  "desktopName": "clankerspanker.desktop",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "prebuild-host": "cd ../host && npm install && npm run build",
    "prepack": "npm run prebuild-host",
    "predist": "npm run prebuild-host",
    "predist:linux": "npm run prebuild-host",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nightmoose.clankerspanker.desktop",
    "productName": "ClankerSpanker",
    "copyright": "Copyright © nightmoose",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../host/dist",
        "to": "host/dist"
      },
      {
        "from": "../host/package.json",
        "to": "host/package.json"
      },
      {
        "from": "../host/package-lock.json",
        "to": "host/package-lock.json"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "resources/icons",
      "synopsis": "Control plane for Grok Build and Claude Code",
      "description": "Desktop shell for ClankerSpanker: connect to a local or remote host gateway, manage agent sessions, and get OS notifications for approvals.",
      "maintainer": "nightmoose <alex.suarez@nightmoose.com>",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "ClankerSpanker",
          "Comment": "Dispatch and supervise Grok / Claude sessions",
          "Categories": "Development;Utility;",
          "StartupWMClass": "clankerspanker",
          "Icon": "clankerspanker"
        }
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-${arch}.deb"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
