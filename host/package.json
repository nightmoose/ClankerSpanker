{
  "name": "clankerspanker-host",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "description": "Local-first host gateway for ClankerSpanker (browser + iOS → Grok Build / Claude Code / Antigravity CLI / in-process bot runtime)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/terminal && cp src/terminal/pty-bridge.py dist/terminal/pty-bridge.py",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "install-service": "bash scripts/install-service.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2"
  }
}
