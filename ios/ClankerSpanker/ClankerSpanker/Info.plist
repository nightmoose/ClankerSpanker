<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nightmoose.clankerspanker.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ClankerSpanker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ClankerSpankerPhone</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nightmoose.clankerspanker</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>clankerspanker</string>
				<string>grokdispatch</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  ATS: do NOT set NSAllowsLocalNetworking alongside NSAllowsArbitraryLoads.
	  On iOS 10+, if NSAllowsLocalNetworking is present, NSAllowsArbitraryLoads is
	  ignored — and Tailscale 100.64/10 is NOT treated as "local", so cleartext to
	  http://100.x.x.x:8787 is blocked (CFNetwork -1022). Only arbitrary loads.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Local Network privacy prompt (separate from ATS; needed for LAN probes). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>ClankerSpanker connects to your Mac host on the local network and Tailscale to run agent sessions.</string>
	<!-- Required: opening UIImagePickerController(.camera) without this crashes immediately. -->
	<key>NSCameraUsageDescription</key>
	<string>ClankerSpanker attaches camera photos to agent messages for debugging UI and app screens.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ClankerSpanker attaches screenshots and photos to agent messages for debugging.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>

